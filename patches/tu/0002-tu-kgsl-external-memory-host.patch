+VkResult
+tu_bo_init_userptr(struct tu_device *dev,
+                   struct tu_bo **bo,
+                   void *host_ptr,
+                   uint64_t size,
+                   VkMemoryPropertyFlags mem_property)
+{
+   if (!dev->instance->knl->bo_init_userptr)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   VkResult result =
+      dev->instance->knl->bo_init_userptr(dev, bo, host_ptr, size, mem_property);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (!(mem_property & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+      (*bo)->cached_non_coherent = true;
+
+   if (!(*bo)->unique_id)
+      (*bo)->unique_id = (*bo)->gem_handle;
+
+   return VK_SUCCESS;
+}
