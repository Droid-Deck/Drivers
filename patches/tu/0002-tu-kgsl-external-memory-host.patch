 }
 
+static VkResult
+kgsl_bo_init_userptr(struct tu_device *dev,
+                     struct tu_bo **out_bo,
+                     void *host_ptr,
+                     uint64_t size,
+                     VkMemoryPropertyFlags mem_property)
+{
+   struct kgsl_gpuobj_import_useraddr import_useraddr = {
+      .virtaddr = reinterpret_cast<uintptr_t>(host_ptr),
+   };
+   struct kgsl_gpuobj_import req = {
+      .priv = reinterpret_cast<uintptr_t>(&import_useraddr),
+      .priv_len = sizeof(import_useraddr),
+      .flags = 0,
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+   int ret;
+
+   /* Host allocations are ordinary write-back cached memory. */
+   req.flags |= KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT;
+   if (mem_property & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
+      req.flags |= KGSL_MEMFLAGS_IOCOHERENT;
+
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_IMPORT, &req);
+   if (ret)
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to import host pointer %p (+%" PRIu64 ") (%s)\n",
+                       host_ptr, size, strerror(errno));
+
+   struct kgsl_gpuobj_info info_req = {
+      .id = req.id,
+   };
+
+   ret = safe_ioctl(dev->physical_device->local_fd,
+                    IOCTL_KGSL_GPUOBJ_INFO, &info_req);
+   if (ret) {
+      const int error = errno;
+      struct kgsl_gpumem_free_id free_req = {
+         .id = req.id,
+      };
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID,
+                 &free_req);
+
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "Failed to get host pointer import info (%s)\n",
+                       strerror(error));
+   }
+
+   struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
+   assert(bo && bo->gem_handle == 0);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = req.id,
+      .size = size,
+      .iova = info_req.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, size, "hostptr"),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .never_unmap = true,
+      .userptr = true,
+   };
+
+   tu_dump_bo_init(dev, bo);
+
+   *out_bo = bo;
+
+   return VK_SUCCESS;
+}
